    <MyceliumIcdFunctionalDataServiceOpenApiPath>$(MyceliumIcdDir)mycelium-functional-data-service.openapi.json</MyceliumIcdFunctionalDataServiceOpenApiPath>
  </PropertyGroup>
</Project>
