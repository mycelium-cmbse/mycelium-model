<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Mycelium.Model.Fabric</PackageId>
    <Version>0.1.0</Version>
    <Title>Mycelium Model - Fabric</Title>
    <Description>UML 2.5.1 model (XMI) for Mycelium Fabric, for use with uml4net-based code generation.</Description>
    <PackageTags>UML XMI mycelium model fabric uml4net</PackageTags>
    <PackageReleaseNotes>Placeholder release: bare-bones mycelium-fabric.xmi, no modeled content yet.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="mycelium-fabric.xmi" Pack="true" PackagePath="model/" />
    <None Include="build\Mycelium.Model.Fabric.props" Pack="true" PackagePath="build\" />
    <None Include="buildTransitive\Mycelium.Model.Fabric.props" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <!-- Fabric's model has a cross-model dependency on CommonPrimitives. This ProjectReference makes
       `dotnet pack` emit a <dependency> on Mycelium.Model.CommonPrimitives in the nuspec (do not add
       ReferenceOutputAssembly="false" here — it silently suppresses that dependency), so NuGet restore
       pulls CommonPrimitives in transitively for any consumer of this package, and its buildTransitive
       props expose $(MyceliumModelCommonPrimitivesXmiPath) to them too. Neither project has any actual
       code to compile — IncludeBuildOutput=false already keeps the (near-empty) build output out of
       both nupkgs. -->
  <!-- The dependency version in the nuspec is CommonPrimitives' *current* <Version> at pack time — that
       exact version must already be published to NuGet.org, or consumers restoring this package will
       fail. See "Model dependencies" in README.md. -->
  <ItemGroup>
    <ProjectReference Include="..\Mycelium.Model.CommonPrimitives\Mycelium.Model.CommonPrimitives.csproj" />
  </ItemGroup>

</Project>
