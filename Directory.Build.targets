<Project>

  <!-- Imported at the bottom of every model project (after the .csproj body).
       $(MSBuildThisFileDirectory) is the repository root (where this file lives), so these paths
       resolve correctly regardless of which subfolder the project itself lives in. -->

  <ItemGroup Label="Shared package assets (README/LICENSE, all model packages)">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
