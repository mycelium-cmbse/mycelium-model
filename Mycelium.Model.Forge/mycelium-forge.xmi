			<element xmi:idref="EAID_95D42105_4640_4742_8548_6498D87AB908" xmi:type="uml:Class" name="Invitation" scope="public">
				<model package="EAPK_A652ED1F_50A3_4d46_9DA8_6BB8DCE482B7" tpos="0" ea_localid="40" ea_eleType="element"/>
				<properties documentation="Abstract super class from which all kinds of Invitations derive." isSpecification="false" sType="Class" nType="0" scope="public" isRoot="false" isLeaf="false" isAbstract="true" isActive="false"/>
				<project author="sgerene" version="1.0" phase="1.0" created="2026-08-09 19:10:32" modified="2026-08-12 09:54:35" complexity="1" status="Proposed"/>
				<code gentype="Java"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="Packaging"/>
				<attributes>
					<attribute xmi:idref="EAID_E3F82141_2DBE_4300_B7D9_A82A0816AFB2" name="experisAt" scope="Public">
						<initial/>
						<documentation value="The DateTime at which the Invitation expires.&#xA;"/>
						<model ea_localid="55" ea_guid="{E3F82141-2DBE-4300-B7D9-A82A0816AFB2}"/>
						<properties type="DateTime" collection="false" static="0" duplicates="0" changeability="changeable"/>
						<coords ordered="0"/>
						<containment containment="Not Specified" position="2"/>
						<stereotype/>
						<bounds lower="1" upper="1"/>
						<options/>
						<style/>
						<styleex value="volatile=0;union=0;"/>
						<tags/>
						<xrefs/>
					</attribute>
					<attribute xmi:idref="EAID_E6B5A8E1_3061_45bd_B6AB_E6F39B0FDE9F" name="isExpired" scope="Public">
						<initial/>
						<documentation value="A derived Boolean indicating whether an Invitation is past its usable window; true when the current moment is later than expiresAt. Not a stored state; it's computed on demand from expiresAt alone, so it's always accurate and never needs to be actively updated or swept by a background process as time passes."/>
						<model ea_localid="66" ea_guid="{E6B5A8E1-3061-45bd-B6AB-E6F39B0FDE9F}"/>
						<properties type="Boolean" derived="1" collection="false" static="0" duplicates="0" changeability="changeable"/>
						<coords ordered="0"/>
						<containment containment="Not Specified" position="2"/>
						<stereotype/>
						<bounds lower="1" upper="1"/>
						<options/>
						<style/>
						<styleex value="volatile=0;union=0;"/>
						<tags/>
						<Constraints>
							<Constraint name="self.expiresAt &lt; now()" type="OCL"/>
						</Constraints>
						<xrefs/>
					</attribute>
					<attribute xmi:idref="EAID_1F5D5916_4806_4a92_A0C3_95CBD1DA1595" name="status" scope="Public">
						<initial/>
						<documentation value="The current state of an Invitation in its lifecycle, typed as InvitationStatusKind. Governs whether the invitation can still be acted on (accepted, declined) or has already been resolved or expired"/>
						<model ea_localid="56" ea_guid="{1F5D5916-4806-4a92-A0C3-95CBD1DA1595}"/>
						<properties type="InvitationStatusKind" collection="false" static="0" duplicates="0" changeability="changeable"/>
						<coords ordered="0"/>
						<containment containment="Not Specified" position="1"/>
						<stereotype/>
						<bounds lower="1" upper="1"/>
						<options/>
						<style/>
						<styleex value="volatile=0;union=0;"/>
						<tags/>
						<xrefs/>
					</attribute>
				</attributes>
				<links>
					<Generalization xmi:id="EAID_14448AC4_C8A8_4fb4_B845_3C9AA5F0FCE7" start="EAID_95D42105_4640_4742_8548_6498D87AB908" end="EAID_7893E744_B7A0_400a_AA2A_00E1BD5F5A0F"/>
