						<options/>
						<style/>
						<styleex value="volatile=0;union=0;"/>
						<tags/>
						<Constraints>
							<Constraint name="OwnedPackagesCannotBeInternal" type="OCL" notes="owner.oclIsKindOf(Account) implies visibility &lt;&gt; Visibility::INTERNAL"/>
						</Constraints>
						<xrefs/>
					</attribute>
				</attributes>
				<links>
					<Association xmi:id="EAID_1122907F_7B04_491a_9894_18D7F240B0C8" start="EAID_65683CA4_032F_457d_B996_A3893C4293CA" end="EAID_367F204E_758E_41a5_892F_22A589405944"/>
