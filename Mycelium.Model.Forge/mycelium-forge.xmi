					</attribute>
					<attribute xmi:idref="EAID_84CB2554_8FEB_49ee_ADC4_8AEAECB7D2D1" name="visibility" scope="Public">
						<initial/>
						<documentation value="Controls who can see and access the Package. INTERNAL is invalid when the owning Scope is an Account, per the earlier invariant, since &quot;internal&quot; only makes sense within an organizational boundary"/>
						<model ea_localid="11" ea_guid="{84CB2554-8FEB-49ee-ADC4-8AEAECB7D2D1}"/>
						<properties type="VisibilityKind" collection="false" static="0" duplicates="0" changeability="changeable"/>
