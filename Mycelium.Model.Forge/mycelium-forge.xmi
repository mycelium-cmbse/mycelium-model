            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000199_079A_4551_A43D_88F5EA5FF592" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_969CFA62_079A_4551_A43D_88F5EA5FF592-_ownedComment.0" body="the tag's text value, stored as a String. Unique after normalisation; what's displayed and matched against in search/autocomplete" />
            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String" />
