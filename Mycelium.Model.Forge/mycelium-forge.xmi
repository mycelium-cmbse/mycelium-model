            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_dst2E6A77_9CEE_4ef3_A3FE_ED24C609B3DA-_ownedComment.0" body="The accounts that exist in Forge" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000078__9CEE_4ef3_A3FE_ED24C609B3DA" value="*" />
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_dst10489B_3E2E_4795_AA63_0F70D1AB3F3A" aggregation="composite" association="EAID_8410489B_3E2E_4795_AA63_0F70D1AB3F3A" name="profileType" type="EAID_A5813AB3_8596_4a27_9755_A3EC87649CF0">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000079__3E2E_4795_AA63_0F70D1AB3F3A" />
