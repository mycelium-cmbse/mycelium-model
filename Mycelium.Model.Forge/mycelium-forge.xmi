  <uml:Model xmi:type="uml:Model" name="mycelium-forge">
    <packagedElement xmi:type="uml:Package" xmi:id="EAPK_30A684F4_E37F_453c_B99D_A9C71B00B06E" name="Forge">
      <ownedRule xmi:type="uml:Constraint" xmi:id="EAID_OR000000_73D8_4c5d_86A2_5768EDE59367" name="downloadCount">
        <constrainedElement xmi:idref="EAID_92CAFF82_73D8_4c5d_86A2_5768EDE59367" />
        <specification xmi:type="uml:OpaqueExpression" xmi:id="EAID_COE000000_73D8_4c5d_86A2_5768EDE59367">
          <body>derive: self.version.downloadCount-&gt;sum()</body>
        </specification>
      </ownedRule>
      <packagedElement xmi:type="uml:Package" xmi:id="EAPK_6E9B5A1A_A344_457b_906A_E3D514EC350D" name="Common">
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_7893E744_B7A0_400a_AA2A_00E1BD5F5A0F" isAbstract="true" name="Thing">
