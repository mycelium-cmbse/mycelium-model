						<xrefs value="$XREFPROP=$XID={CB37FC2E-771C-4968-A9FA-509729EC7A3C}$XID;$NAM=CustomProperties$NAM;$TYP=attribute property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=isID@ENDNAME;@TYPE=Boolean@ENDTYPE;@VALU=1@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={03CDEFB7-67B8-4310-A5D7-E3FA99CBDD57}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;" />
					</attribute>
					<attribute xmi:idref="EAID_92CAFF82_73D8_4c5d_86A2_5768EDE59367" name="downloadCount" scope="Public">
						<initial />
						<documentation value="Total downloads across the Package, computed as the sum of downloadCount over all its PackageVersions. Never set directly; always reflects the current totals of its versions." />
						<model ea_localid="428" ea_guid="{92CAFF82-73D8-4c5d-86A2-5768EDE59367}" />
