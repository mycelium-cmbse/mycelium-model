          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_dstEAA194_978B_4aa5_BEBC_DC3C38829711" aggregation="composite" association="EAID_7BEAA194_978B_4aa5_BEBC_DC3C38829711" name="version" type="EAID_88E567A2_4C86_4df5_B815_57A992FC2912">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000129__978B_4aa5_BEBC_DC3C38829711" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_dstEAA194_978B_4aa5_BEBC_DC3C38829711-_ownedComment.0" body="The PackageVersions that are owned by the Package" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000130__978B_4aa5_BEBC_DC3C38829711" value="*" />
          </ownedAttribute>
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_65683CA4_032F_457d_B996_A3893C4293CA-_ownedComment.0" body="A named, versioned unit of software published to the Forge, owned by exactly one Scope (an Organization or an Account) and containing one or more PackageVersions" />
          <ownedRule xmi:type="uml:Constraint" xmi:id="EAID_OR000000_032F_457d_B996_A3893C4293CA" name="ownedPackagesCannotBeInternal">
            <constrainedElement xmi:idref="EAID_65683CA4_032F_457d_B996_A3893C4293CA" />
            <specification xmi:type="uml:OpaqueExpression" xmi:id="EAID_COE000000_032F_457d_B996_A3893C4293CA">
              <body>inv ownedPackagesCannotBeInternal: owner.oclIsKindOf(Account) implies visibility &amp;lt;&amp;gt; Visibility::INTERNAL</body>
            </specification>
          </ownedRule>
        </packagedElement>
