            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000178_0569_48ac_82E7_27B0421290FB" value="1" />
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_32B9DDDF_0FF1_4922_9BFC_58D6204BBF0B" name="defaultPackageVisibility" type="EAID_09D68D98_A5CD_401f_A176_FCBDA91A47F2">
            <defaultValue xmi:type="uml:LiteralString" xmi:id="EAID_LI000181_0FF1_4922_9BFC_58D6204BBF0B" value="PRIVATE" />
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000179_0FF1_4922_9BFC_58D6204BBF0B" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_32B9DDDF_0FF1_4922_9BFC_58D6204BBF0B-_ownedComment.0" body="The default visibility of a scope, this can only be set by the administrator(s) or owner of the Scope" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000180_0FF1_4922_9BFC_58D6204BBF0B" value="1" />
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_A3370745_185E_4a8b_BF80_3C9CE8B4B7CE" isID="true" isUnique="false" name="email">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000181_185E_4a8b_BF80_3C9CE8B4B7CE" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_A3370745_185E_4a8b_BF80_3C9CE8B4B7CE-_ownedComment.0" body="The email address where the Scope can be reached for anything unrelated to billing." />
            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000182_185E_4a8b_BF80_3C9CE8B4B7CE" value="1" />
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_3A696494_7AB4_4608_95BD_E60428D81D1B" isID="true" isUnique="false" name="origin">
            <defaultValue xmi:type="uml:LiteralString" xmi:id="EAID_LI000185_7AB4_4608_95BD_E60428D81D1B" value="local" />
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000183_7AB4_4608_95BD_E60428D81D1B" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_3A696494_7AB4_4608_95BD_E60428D81D1B-_ownedComment.0" body="Denotes whether the Scope was created local to this Forge instance, or whether it was proxied from another location. When the value states  &quot;local&quot;, then it is local to the current Forge instance, otherwise the value needs to be a URI pointing to the location it was proxied from." />
            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000184_7AB4_4608_95BD_E60428D81D1B" value="1" />
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_98A41878_8269_4533_A0B2_0F3F7989F334" isID="true" isUnique="false" name="status" type="EAID_9A028E25_FC70_4657_AB28_7A637060D7AA">
            <defaultValue xmi:type="uml:LiteralString" xmi:id="EAID_LI000187_8269_4533_A0B2_0F3F7989F334" value="ACTIVE" />
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000185_8269_4533_A0B2_0F3F7989F334" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_98A41878_8269_4533_A0B2_0F3F7989F334-_ownedComment.0" body="The status of the Scope, when the Scope is an Account, inactive means the user that cannot login anymore. When the scope is an Organization, packages can no longer be published or uploaded, nor any PackageVersions" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000186_8269_4533_A0B2_0F3F7989F334" value="1" />
          </ownedAttribute>
