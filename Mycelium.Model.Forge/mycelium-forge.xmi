				<properties documentation="Identifies which packaging ecosystem a given Package (and its PackageVersions) belongs to; i.e., which language or platform's native package format, manifest structure, and versioning convention Forge should apply when storing, indexing, and serving that package. Because different ecosystems use incompatible manifest schemas, dependency-resolution rules, and file layouts, PackageType is effectively a discriminator: it determines which parsing logic, validation rules, and protocol-specific API endpoint the Forge routes a given Package through." isSpecification="false" sType="Class" nType="0" scope="public" isRoot="false" isLeaf="false" isAbstract="false" isActive="false" />
