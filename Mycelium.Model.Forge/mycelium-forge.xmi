          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_92CAFF82_73D8_4c5d_86A2_5768EDE59367" isDerived="true" name="downloadCount">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000117_73D8_4c5d_86A2_5768EDE59367" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_92CAFF82_73D8_4c5d_86A2_5768EDE59367-_ownedComment.0" body="Total downloads across the Package, computed as the sum of downloadCount over all its PackageVersions. Never set directly; always reflects the current totals of its versions." />
            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#Integer" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000118_73D8_4c5d_86A2_5768EDE59367" value="1" />
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_4F8A692D_12D7_4a0e_BF07_B7BD116E7E01" name="listed">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000119_12D7_4a0e_BF07_B7BD116E7E01" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_4F8A692D_12D7_4a0e_BF07_B7BD116E7E01-_ownedComment.0" body="Whether the Package appears in search results and browsable listings. When false, it's still reachable directly (e.g. by exact name or link) but hidden from discovery." />
