            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_A77832B4_3C0A_4b88_86D5_B5814925CC2E-_ownedComment.0" body="The postal or ZIP code. Optional, since some countries don't use postal codes at all." />
            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000036_3C0A_4b88_86D5_B5814925CC2E" value="1" />
          </ownedAttribute>
