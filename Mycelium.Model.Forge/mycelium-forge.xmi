            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_C2F6FF93_7B10_437a_8A7B_DDCD5F120E5F-_ownedComment.0" body="a human readable name that makes it easy to identify" />
            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000050_7B10_437a_8A7B_DDCD5F120E5F" value="1" />
