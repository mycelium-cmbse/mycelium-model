			<element xmi:idref="EAID_65683CA4_032F_457d_B996_A3893C4293CA" xmi:type="uml:Class" name="Package" scope="public">
				<model package="EAPK_A652ED1F_50A3_4d46_9DA8_6BB8DCE482B7" tpos="0" ea_localid="3" ea_eleType="element"/>
				<properties documentation="A named, versioned unit of software published to the Forge, owned by exactly one Scope (an Organization or an Account) and containing one or more PackageVersions" isSpecification="false" sType="Class" nType="0" scope="public" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
				<project author="sgerene" version="1.0" phase="1.0" created="2026-08-09 13:41:24" modified="2026-08-12 10:12:14" complexity="1" status="Proposed"/>
				<code gentype="Java"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="Packaging"/>
				<attributes>
					<attribute xmi:idref="EAID_92CAFF82_73D8_4c5d_86A2_5768EDE59367" name="downloadCount" scope="Public">
						<initial/>
						<documentation value="Total downloads across the Package, computed as the sum of downloadCount over all its PackageVersions. Never set directly; always reflects the current totals of its versions."/>
						<model ea_localid="13" ea_guid="{92CAFF82-73D8-4c5d-86A2-5768EDE59367}"/>
						<properties type="Integer" derived="1" collection="false" static="0" duplicates="0" changeability="changeable"/>
