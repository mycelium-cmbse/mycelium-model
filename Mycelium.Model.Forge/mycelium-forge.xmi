					<attribute xmi:idref="EAID_98A41878_8269_4533_A0B2_0F3F7989F334" name="status" scope="Public">
						<initial body="ACTIVE"/>
						<documentation value="The status of the Scope, when the Scope is an Account, inactive means the user that cannot login anymore. When the scope is an Organization, packages can no longer be published or uploaded, nor any PackageVersions"/>
