            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000051_E760_475c_B930_D338B5356217" />
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_011DC793_E760_475c_B930_D338B5356217-_ownedComment.0" body="the set of permissions that define what can be done with the API key on behalf of the Account that owns the API key." />
