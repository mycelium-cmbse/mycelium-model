            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_dst71ABB8_0FA0_4c8c_BB03_2A1FCAD7F07E-_ownedComment.0" body="The addresses that are owned or contained by the Scope" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000196__0FA0_4c8c_BB03_2A1FCAD7F07E" value="*" />
          </ownedAttribute>
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_72DEAA6C_B955_498d_9BBE_A2478380CD29-_ownedComment.0" body="The common abstraction shared by Account and Organization that makes sure Packages can be stored and that names and shortnames of scopes and packages owned or contained by the scopes are globally unique." />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_B267D33A_7D03_4de8_BC66_066A0EC0DF2D" name="Tag">
