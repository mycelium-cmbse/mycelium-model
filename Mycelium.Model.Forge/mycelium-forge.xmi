        </packagedElement>
        <packagedElement xmi:type="uml:Enumeration" xmi:id="EAID_3D7293DB_D995_47d2_8BBE_EB69E1A981B0" name="InvitationStatusKind">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_3D7293DB_D995_47d2_8BBE_EB69E1A981B0-_ownedComment.0" body="Enumeration datatype that asserts the status of the invitation" />
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_9E5A78E7_DD41_4739_8D05_835B91FB9082" name="PENDING">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_9E5A78E7_DD41_4739_8D05_835B91FB9082-_ownedComment.0" body="Assertion that the invitation is pending either acceptance or rejection" />
          </ownedLiteral>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_63A860B0_B097_4af5_8608_738752868C15" name="ACCEPTED">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_63A860B0_B097_4af5_8608_738752868C15-_ownedComment.0" body="Assertion that the invitation has been accepted." />
          </ownedLiteral>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_F6CAA847_9ECE_44ef_8250_EB05BEF9BE2E" name="REJECTED">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_F6CAA847_9ECE_44ef_8250_EB05BEF9BE2E-_ownedComment.0" body="Assertion that the invitation has been rejected." />
          </ownedLiteral>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_57658D81_FD6E_41b7_B061_146510ED7CE1" name="REVOKED">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_57658D81_FD6E_41b7_B061_146510ED7CE1-_ownedComment.0" body="Cancelled by the inviter before the recipient responded, distinct from the recipient declining it themselves." />
          </ownedLiteral>
        </packagedElement>
        <packagedElement xmi:type="uml:Enumeration" xmi:id="EAID_0FA0C42D_0F0D_4371_8A5E_468BD9DEA910" name="OrganizationInvitationKind">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_0FA0C42D_0F0D_4371_8A5E_468BD9DEA910-_ownedComment.0" body="Enumeration datatype that denotes the kind of organization invitation is being sent." />
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_89D63F1A_FE47_483e_BAB0_B8DEDCF111FA" name="MEMBER">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_89D63F1A_FE47_483e_BAB0_B8DEDCF111FA-_ownedComment.0" body="Assertion that the invitation is for the target Account to become an Organization MEMBER." />
          </ownedLiteral>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_4540A1EC_CC27_4fa1_AC3D_AF934CAA75F2" name="ADMINISTRATOR">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_4540A1EC_CC27_4fa1_AC3D_AF934CAA75F2-_ownedComment.0" body="Assertion that the invitation is for the target Account to become an Organization ADMINISTRATOR." />
          </ownedLiteral>
        </packagedElement>
        <packagedElement xmi:type="uml:Enumeration" xmi:id="EAID_99E6DF6B_5970_44c4_A0E8_60E5955EC10B" name="PackageInvitationKind">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_99E6DF6B_5970_44c4_A0E8_60E5955EC10B-_ownedComment.0" body="Enumeration datatype that denotes the kind of Package invitation is being sent." />
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_490B0472_276C_4db2_9569_C66A92DF0293" name="OWNER">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_490B0472_276C_4db2_9569_C66A92DF0293-_ownedComment.0" body="Assertion that the invitation is for the target Account to become a Package OWNER." />
          </ownedLiteral>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_FC25FA96_6C00_4738_9CBB_1098F0AE6CD3" name="MAINTAINER">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_FC25FA96_6C00_4738_9CBB_1098F0AE6CD3-_ownedComment.0" body="Assertion that the invitation is for the target Account to become a Package MAINTAINER." />
          </ownedLiteral>
        </packagedElement>
        <packagedElement xmi:type="uml:Enumeration" xmi:id="EAID_9A028E25_FC70_4657_AB28_7A637060D7AA" name="ScopeStatusKind">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_9A028E25_FC70_4657_AB28_7A637060D7AA-_ownedComment.0" body="Enumeration Datatype that specifies whether a Scope is active or inactive (deactivated)" />
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_5DBB9C36_594E_41db_A8B4_2D533FE6AD5F" name="ACTIVE">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_5DBB9C36_594E_41db_A8B4_2D533FE6AD5F-_ownedComment.0" body="Assertion that the ScopeStatusKind is Active" />
          </ownedLiteral>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_0F059940_1F78_4ef4_B7A2_994BC205CD56" name="DEACTIVATED">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_0F059940_1F78_4ef4_B7A2_994BC205CD56-_ownedComment.0" body="Assertion that the ScopeStatusKind has been deactived, ie is inactive&#xA;" />
          </ownedLiteral>
        </packagedElement>
        <packagedElement xmi:type="uml:Enumeration" xmi:id="EAID_09D68D98_A5CD_401f_A176_FCBDA91A47F2" name="VisibilityKind">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_09D68D98_A5CD_401f_A176_FCBDA91A47F2-_ownedComment.0" body="Enumeration DataType that states the visibility of a Scope" />
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_C42B9747_44D7_4aca_BD7C_2A9902EE611A" name="PUBLIC">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_C42B9747_44D7_4aca_BD7C_2A9902EE611A-_ownedComment.0" body="Assertion that the VisibilityKind is public, i.e. visible to anonymous users" />
          </ownedLiteral>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_CAA65E30_1701_43b5_8057_16A20DB1B87B" name="INTERNAL">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_CAA65E30_1701_43b5_8057_16A20DB1B87B-_ownedComment.0" body="Assertion that the VisibilityKind is internal i.e. visible only to accounts that are a member of an Organization or to a member of a Package&#xA;" />
          </ownedLiteral>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="EAID_7DD7FBA1_EFC3_41cb_9672_5EB098B66C57" name="PRIVATE">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_7DD7FBA1_EFC3_41cb_9672_5EB098B66C57-_ownedComment.0" body="Assertion that the VisibilityKind is private i.e. visible only to accounts that are a owners of an Organization or to a owners of a Package&#xA;&#xA;" />
          </ownedLiteral>
        </packagedElement>
      </packagedElement>
