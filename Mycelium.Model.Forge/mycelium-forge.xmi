						<tags />
						<xrefs />
					</attribute>
				</attributes>
				<constraints>
					<constraint name="ownedPackagesCannotBeInternal" description="inv ownedPackagesCannotBeInternal: owner.oclIsKindOf(Account) implies visibility &amp;lt;&amp;gt; Visibility::INTERNAL" type="OCL" weight="0,00" status="Approved" />
				</constraints>
				<links>
					<Association xmi:id="EAID_1122907F_7B04_491a_9894_18D7F240B0C8" start="EAID_65683CA4_032F_457d_B996_A3893C4293CA" end="EAID_367F204E_758E_41a5_892F_22A589405944" />
