          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_DCE3B0E0_26D6_4045_BC60_741D2288A6A3" name="addressLine2">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000031_26D6_4045_BC60_741D2288A6A3" />
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_DCE3B0E0_26D6_4045_BC60_741D2288A6A3-_ownedComment.0" body="An optional second line for anything that doesn't fit on the first: apartment or suite number, floor, building name, or similar. Left empty when not needed." />
            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000032_26D6_4045_BC60_741D2288A6A3" value="1" />
