            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000029_C62C_4751_8AD7_2E9F6AA392A0" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_F497BB6E_C62C_4751_8AD7_2E9F6AA392A0-_ownedComment.0" body="The primary address line: street name and house/building number, or the main identifying line for addresses that don't follow a street-and-number convention. Mandatory � every Address must have at least this line." />
            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000030_C62C_4751_8AD7_2E9F6AA392A0" value="1" />
