            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000054_58DB_42e3_901D_97F7677A9793" value="1" />
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_796BF175_5F57_4cf9_A60D_AA7936A12A6C" name="secretHash">
