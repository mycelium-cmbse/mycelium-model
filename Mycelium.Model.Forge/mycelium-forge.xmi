            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000197_5692_4f89_88DD_F3CEB21DA1D5" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_99DCF2DF_5692_4f89_88DD_F3CEB21DA1D5-_ownedComment.0" body="Indicates whether the tag is part of the Forge's curated global tag set rather than an ad-hoc, user-created label." />
            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#Integer" />
