					<packagedElement xmi:type="uml:Class" xmi:id="EAID_7F7FC764_FFCB_4383_B10D_2D967C351E01" name="Organization">
						<ownedRule xmi:type="uml:Constraint" xmi:id="EAID_OR000000_FFCB_4383_B10D_2D967C351E01" name="administrator-&gt;forAll(a | member-&gt;includes(a))">
							<constrainedElement xmi:idref="EAID_7F7FC764_FFCB_4383_B10D_2D967C351E01"/>
							<specification xmi:type="uml:OpaqueExpression" xmi:id="EAID_COE000000_FFCB_4383_B10D_2D967C351E01" body="AdministratorsAreMembers&#xA;&#xA;Every Account acting as an administrator of an Organization must also be a member of that same Organization. In other words, administrator status cannot exist on its own — being a member is a prerequisite for being an administrator, so the set of administrators is always contained within the set of members."/>
						</ownedRule>
						<ownedRule xmi:type="uml:Constraint" xmi:id="EAID_OR000001_FFCB_4383_B10D_2D967C351E01" name="administrator-&gt;notEmpty()">
							<constrainedElement xmi:idref="EAID_7F7FC764_FFCB_4383_B10D_2D967C351E01"/>
							<specification xmi:type="uml:OpaqueExpression" xmi:id="EAID_COE000001_FFCB_4383_B10D_2D967C351E01" body="AtLeastOneAdministrator&#xA;&#xA;Every Organization must have at least one administrator at all times. An organization can never exist in a state where its set of administrators is empty, someone must always be responsible for managing it."/>
						</ownedRule>
