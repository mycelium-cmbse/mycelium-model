					<attribute xmi:idref="EAID_3A696494_7AB4_4608_95BD_E60428D81D1B" name="origin" scope="Public">
						<initial/>
						<documentation value="Denotes whether the Scope was created local to this Forge instance, or whether it was proxied from another location. When the value states  &quot;local&quot;, then it is local to the current Forge instance, otherwise the value needs to be a URI pointing to the location it was proxied from."/>
						<model ea_localid="69" ea_guid="{3A696494-7AB4-4608-95BD-E60428D81D1B}"/>
						<properties type="String" collection="false" static="0" duplicates="0" changeability="changeable"/>
