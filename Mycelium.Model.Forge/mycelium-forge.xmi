            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000120_12D7_4a0e_BF07_B7BD116E7E01" value="1" />
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_84CB2554_8FEB_49ee_ADC4_8AEAECB7D2D1" name="visibility" type="EAID_09D68D98_A5CD_401f_A176_FCBDA91A47F2">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000121_8FEB_49ee_ADC4_8AEAECB7D2D1" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_84CB2554_8FEB_49ee_ADC4_8AEAECB7D2D1-_ownedComment.0" body="Controls who can see and access the Package. INTERNAL is invalid when the owning Scope is an Account, per the earlier invariant, since &quot;internal&quot; only makes sense within an organizational boundary" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000122_8FEB_49ee_ADC4_8AEAECB7D2D1" value="1" />
          </ownedAttribute>
