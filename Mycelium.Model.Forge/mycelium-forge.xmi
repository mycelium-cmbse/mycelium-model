            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000038_4997_452b_A3C0_E8B4B04792D0" value="1" />
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_dst2EF30B_33AF_40b7_ADBC_745E4144AF15" association="EAID_0B2EF30B_33AF_40b7_ADBC_745E4144AF15" name="country" type="EAID_A94A65F7_045C_49d9_9307_1DBFF810C3F4">
