            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000081__EBC4_4186_B88D_3B78570FFDFA" />
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_dstF15AA0_EBC4_4186_B88D_3B78570FFDFA-_ownedComment.0" body="The PackageTypes that are known to Forge" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000082__EBC4_4186_B88D_3B78570FFDFA" value="*" />
