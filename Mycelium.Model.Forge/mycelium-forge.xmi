						<styleex value="volatile=0;union=0;" />
						<tags />
						<Constraints>
							<Constraint name="downloadCount" type="OCL" notes="derive: self.version.downloadCount-&gt;sum()" />
						</Constraints>
						<xrefs />
					</attribute>
					<attribute xmi:idref="EAID_4F8A692D_12D7_4a0e_BF07_B7BD116E7E01" name="listed" scope="Public">
						<initial />
						<documentation value="Whether the Package appears in search results and browsable listings. When false, it's still reachable directly (e.g. by exact name or link) but hidden from discovery." />
						<model ea_localid="429" ea_guid="{4F8A692D-12D7-4a0e-BF07-B7BD116E7E01}" />
