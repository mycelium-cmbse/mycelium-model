            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000040__33AF_40b7_ADBC_745E4144AF15" value="1" />
          </ownedAttribute>
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_5E20ADE8_09B7_4fdd_993D_A80F2328C5AE-_ownedComment.0" body="Represents a physical or postal address." />
