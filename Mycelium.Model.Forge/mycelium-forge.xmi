            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000033_5751_4c0e_B20A_9DEC0290ADE5" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_CB512ED7_5751_4c0e_B20A_9DEC0290ADE5-_ownedComment.0" body="The city, town, or equivalent settlement the address falls within." />
            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000034_5751_4c0e_B20A_9DEC0290ADE5" value="1" />
          </ownedAttribute>
