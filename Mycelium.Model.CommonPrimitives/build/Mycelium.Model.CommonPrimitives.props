<Project>
  <PropertyGroup>
    <!-- $(MSBuildThisFileDirectory) = .../build/ or .../buildTransitive/ inside the installed package -->
    <MyceliumModelDir>$(MSBuildThisFileDirectory)../model/</MyceliumModelDir>
    <MyceliumModelCommonPrimitivesXmiPath>$(MyceliumModelDir)mycelium-commonprimitives.xmi</MyceliumModelCommonPrimitivesXmiPath>
  </PropertyGroup>
</Project>
